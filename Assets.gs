/**
 * Opportunity@Work horizontal logo lockup, base64-encoded PNG, embedded so the
 * Apps Script web app has no dependency on an external asset host. Ported
 * verbatim from the design bundle's assets/logo-horizontal.png.
 */
function getLogoDataUri() {
  return 'data:image/png;base64,';
}

/**
 * Ad Council square logo mark (black background, white wordmark),
 * base64-encoded PNG, embedded the same way as getLogoDataUri() above so the
 * partner's branding shows alongside Opportunity@Work's without depending on
 * an external asset host.
 */
function getPartnerLogoDataUri() {
  return 'data:image/png;base64,';
}

/**
 * Ad Council square logo mark, reversed for dark backgrounds: a white
 * square with the wordmark knocked out (transparent), so whatever's behind
 * it (e.g. the footer's dark navy) shows through the letters. Use this one
 * on dark surfaces instead of getPartnerLogoDataUri() — no CSS filter
 * needed, it's a dedicated asset.
 */
function getPartnerLogoWhiteDataUri() {
  return 'data:image/png;base64,';
}
