var DEFINITIONS_SEED = [{"id":"1.0","defType":"Journey Definition","category":"Hasn't begun the Journey","type":"Core Behavior","definition":"Degree-default hiring; no operational changes; DEI language not connected to credential access","evidence":"Default classification when evidence is absent or only generic"},{"id":"2.0","defType":"Classification Decision Rules","category":"Hasn't begun the Journey","type":"Core Behavior","definition":"Evidence is absent, ambiguous, or limited to generic DEI/diversity copy. Job postings require 4-year degrees with no \"or equivalent experience\" language. The only signals are aspirational (\"we value diverse perspectives\") without operational backing. You cannot find a named program, specific policy change, or verifiable commitment.","evidence":""},{"id":"3.0","defType":"Journey Definition","category":"Starting the Journey","type":"Core Behavior","definition":"At least one operational change or documented pilot — not just aspirational language","evidence":"1+ concrete action (specific job postings changed, named program launched, public commitment with details)"},{"id":"4.0","defType":"Classification Decision Rules","category":"Starting the Journey","type":"Core Behavior","definition":"Require concrete operational evidence to reach Starting :Generic phrases like \"equal opportunity employer,\" \"diverse backgrounds welcome,\" or \"we value all experience\" are not sufficient — these are boilerplate. \"Non-traditional backgrounds welcome\" alone is not sufficient unless paired with a specific program or job posting change. A single blog post or social media comment from a leader, with no corroborating operational change, is not sufficient. Sufficient: a named apprenticeship or earn-and-learn program; specific job postings with \"degree or equivalent experience\" language; documented membership in a hiring commitment coalition (OneTen, Tear the Paper Ceiling); a public announcement of degree requirement removal in specific roles.","evidence":""},{"id":"5.0","defType":"Journey Definition","category":"On the Journey","type":"Core Behavior","definition":"Active implementation across defined job families; processes and guardrails present","evidence":"Multiple corroborating signals across ≥2 sub-categories, at least one verifiable at scale"},{"id":"6.0","defType":"Classification Decision Rules","category":"On the Journey","type":"Core Behavior","definition":"On the Journey requires scale + process: Not just one pilot or one job family — changes must be documented across multiple roles or an entire business unit. Must show evidence of process (recruiter training, policy change, validated assessments) not just intent.","evidence":""},{"id":"7.0","defType":"Journey Definition","category":"Leading the Journey","type":"Core Behavior","definition":"Structural embedding; peers and vendors publicly cite or follow this company's lead","evidence":"External validation (citations, case studies, peer adoption) + internal scale"},{"id":"8.0","defType":"Classification Decision Rules","category":"Leading the Journey","type":"Core Behavior","definition":"Leading requires external validation: The company must be visibly influencing peers, vendors, or policy — not just leading internally. Self-reported \"leadership\" language does not qualify.","evidence":""},{"id":"9.0","defType":"Labor Market-shaping Behavior","category":"Hasn't begun the Journey","type":"Sub-Category","definition":"Degree required in all/most postings; no alternative pathways.","evidence":""},{"id":"10.0","defType":"AI-driven Hiring","category":"Hasn't begun the Journey","type":"Sub-Category","definition":"No skills-matching AI; tools used for scheduling only.","evidence":""},{"id":"11.0","defType":"Risk & Compliance","category":"Hasn't begun the Journey","type":"Sub-Category","definition":"No legal/compliance engagement with hiring changes.","evidence":""},{"id":"12.0","defType":"Internal Mobility & Reskilling","category":"Hasn't begun the Journey","type":"Sub-Category","definition":"No mobility programs; advancement tied to credentials.","evidence":""},{"id":"13.0","defType":"Vendor & Ecosystem Influence","category":"Hasn't begun the Journey","type":"Sub-Category","definition":"Default degree filters active in ATS; no vendor conversations.","evidence":""},{"id":"14.0","defType":"Narrative Normalization","category":"Hasn't begun the Journey","type":"Sub-Category","definition":"Credential/prestige framing; generic DEI copy only.","evidence":""},{"id":"15.0","defType":"Labor Market-shaping Behavior","category":"Starting the Journey","type":"Sub-Category","definition":"Named pilot or postings with \"degree or equivalent experience\".","evidence":""},{"id":"16.0","defType":"AI-driven Hiring","category":"Starting the Journey","type":"Sub-Category","definition":"Exploring or testing bias-reduction AI tools.","evidence":""},{"id":"17.0","defType":"Risk & Compliance","category":"Starting the Journey","type":"Sub-Category","definition":"Legal permits limited pilots; benchmarking underway.","evidence":""},{"id":"18.0","defType":"Internal Mobility & Reskilling","category":"Starting the Journey","type":"Sub-Category","definition":"Named early-stage program; curiosity about frontline advancement.","evidence":""},{"id":"19.0","defType":"Vendor & Ecosystem Influence","category":"Starting the Journey","type":"Sub-Category","definition":"Asking vendors about skills-based capabilities.","evidence":""},{"id":"20.0","defType":"Narrative Normalization","category":"Starting the Journey","type":"Sub-Category","definition":"On-record exec statements about skills/credential change, backed by action.","evidence":""},{"id":"21.0","defType":"Labor Market-shaping Behavior","category":"On the Journey","type":"Sub-Category","definition":"Degrees removed across defined job families; recruiters instructed.","evidence":""},{"id":"22.0","defType":"AI-driven Hiring","category":"On the Journey","type":"Sub-Category","definition":"AI skills-screening deployed at scale with guardrails.","evidence":""},{"id":"23.0","defType":"Risk & Compliance","category":"On the Journey","type":"Sub-Category","definition":"Validated assessments paired with degree removal; HR-legal guidelines co-developed.","evidence":""},{"id":"24.0","defType":"Internal Mobility & Reskilling","category":"On the Journey","type":"Sub-Category","definition":"Data showing non-degree workers promoted; skills-based matching tools deployed.","evidence":""},{"id":"25.0","defType":"Vendor & Ecosystem Influence","category":"On the Journey","type":"Sub-Category","definition":"Procurement requires skills capabilities; vendors have adjusted for this employer.","evidence":""},{"id":"26.0","defType":"Narrative Normalization","category":"On the Journey","type":"Sub-Category","definition":"ESG reports explicitly reference skills + mobility; careers page updated.","evidence":""},{"id":"27.0","defType":"Labor Market-shaping Behavior","category":"Leading the Journey","type":"Sub-Category","definition":"Default degree-optional across roles; peers publicly cite this company.","evidence":""},{"id":"28.0","defType":"AI-driven Hiring","category":"Leading the Journey","type":"Sub-Category","definition":"Published case studies; vendors redesign products for them.","evidence":""},{"id":"29.0","defType":"Risk & Compliance","category":"Leading the Journey","type":"Sub-Category","definition":"Global compliance integration; toolkits shared with other organizations.","evidence":""},{"id":"30.0","defType":"Internal Mobility & Reskilling","category":"Leading the Journey","type":"Sub-Category","definition":"Mobility outcomes shared publicly; positioned as core strategy by leadership.","evidence":""},{"id":"31.0","defType":"Vendor & Ecosystem Influence","category":"Leading the Journey","type":"Sub-Category","definition":"Market-level standards shaped by this employer; SMBs benefit from product changes.","evidence":""},{"id":"32.0","defType":"Narrative Normalization","categ